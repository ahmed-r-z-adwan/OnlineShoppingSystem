{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['uid', 'name', 'email', 'role'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "role": {
          ".validate": "newData.val() === 'customer' || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "categories": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$categoryId": {
        ".validate": "newData.hasChildren(['id', 'name'])",
        "id": {
          ".validate": "newData.val() === $categoryId"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "imageBase64": {
          ".validate": "newData.isString() && newData.val().length <= 8000000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "products": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$productId": {
        ".validate": "newData.hasChildren(['id', 'name', 'price'])",
        "id": {
          ".validate": "newData.val() === $productId"
        },
        "categoryId": {
          ".validate": "newData.isString()"
        },
        "categoryName": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "description": {
          ".validate": "newData.isString()"
        },
        "imageBase64": {
          ".validate": "newData.isString() && newData.val().length <= 8000000"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "rate": {
          ".validate": "newData.isNumber()"
        },
        "location": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "carts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$itemId": {
          "userId": {
            ".validate": "newData.val() === $uid"
          },
          "price": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "quantity": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          }
        }
      }
    },
    "orders": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$orderId": {
          ".validate": "newData.hasChildren(['userId', 'totalAmount', 'status', 'timestamp'])",
          "userId": {
            ".validate": "newData.val() === $uid"
          },
          "totalAmount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "status": {
            ".validate": "newData.isString()"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
