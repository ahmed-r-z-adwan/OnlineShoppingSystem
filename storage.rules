rules_version = '2';

// Cloud Storage rules for the product images the admin screens upload.
// Deploy with:  firebase deploy --only storage
//
// A note on the admin check. Storage rules cannot read the Realtime Database, so the
// `users/$uid/role` field these rules would want to consult is simply not reachable from
// here. The only way to express "admin" at this layer is a custom claim on the auth
// token, set once per admin from a trusted environment:
//
//     admin.auth().setCustomUserClaims(uid, { admin: true })
//
// Until that claim is set, the rule below falls back to any signed-in user, bounded by a
// size and content-type check. That is weaker than the database rules, and it is written
// down rather than left implied.
service firebase.storage {
  match /b/{bucket}/o {

    match /products/{imageId} {
      // Any signed-in shopper needs to see product images.
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && (request.auth.token.admin == true || !('admin' in request.auth.token))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Nothing outside products/ is reachable at all.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
